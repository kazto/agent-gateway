[Unit]
Description=AI Agent Gateway (PTY HTTP/WebSocket Server)
After=network.target

[Service]
Type=simple
ExecStart=%h/.cargo/bin/agent-gateway
Restart=on-failure
RestartSec=3
Environment="PATH=%h/.local/bin:%h/.cargo/bin:/usr/local/bin:/usr/bin:/bin"
Environment="RUST_LOG=agent_gateway=info"

[Install]
WantedBy=default.target
